RRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_time_spaced_bubble_column", "target": "src_three_waterflow_buildride", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_time_spaced_bubble_column", "target": "src_three_path_buildpath", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_grit_capture", "target": "src_three_waterflow_grit", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_route_line", "target": "src_three_waterflow_routeline", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_route_line", "target": "readme_colour_ramp_across_element", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_walkthrough_timeline", "target": "src_hooks_usewalkthrough_usewalkthrough", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_walkthrough_timeline", "target": "src_app_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_walkthrough_timeline", "target": "src_data_constants_stage_dwell_ms", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_walkthrough_timeline", "target": "src_data_co