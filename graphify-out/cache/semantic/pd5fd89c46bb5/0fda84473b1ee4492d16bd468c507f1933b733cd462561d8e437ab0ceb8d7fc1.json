{"nodes": [{"id": "legacy_filtration_simulation", "label": "filtration-simulation.html", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Original single-file prototype kept verbatim: inline CSS dark theme, hand-written DOM UI (sidebar, floating cards, play bar, stage dots) and a three.js r128 scene loaded from cdnjs with a global-script orbit rig, a single CatmullRom service line, three canisters and a tap, water pulses and contaminant specks. Wires DOM events at load: window load -> buildScene + selectStage('carbon')."}, {"id": "legacy_filtration_simulation_makeorbit", "label": "makeOrbit()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L276", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Drag-to-orbit camera rig factory: spherical theta/phi/radius state, pointer drag with a click-vs-drag threshold (moved < 6 px fires _onClickPick), wheel zoom clamped to min/max radius, auto-rotate after 2.2 s idle, and returns tick/focus/reset/setClickHandler."}, {"id": "legacy_filtration_simulation_updatecamera", "label": "updateCamera()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L289", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Places the camera on the sphere defined by theta/phi/radius around the target and calls lookAt."}, {"id": "legacy_filtration_simulation_tweento", "label": "tweenTo()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L323", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Cubic ease-out fly-to over requestAnimationFrame: lerps target, radius and optionally theta/phi over a duration (default 850 ms). No angle normalisation, so laps of auto-rotate unwind on reset."}, {"id": "legacy_filtration_simulation_tick", "label": "orbit.tick()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L342", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Per-frame rig update: accumulates idle time and auto-rotates theta when not dragging after 2.2 s."}, {"id": "legacy_filtration_simulation_focus", "label": "orbit.focus()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L349", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Flies the camera target to a position at a given radius, leaving theta/phi untouched."}, {"id": "legacy_filtration_simulation_reset", "label": "orbit.reset()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L352", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Tweens back to the initial target, default radius, theta and phi over 800 ms."}, {"id": "legacy_filtration_simulation_buildscene", "label": "buildScene()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L367", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Builds the whole three.js scene: renderer (pixel ratio capped at 2), fog, lights, grid, box house with extruded roof, service-line CatmullRomCurve3 tube from street meter to tap, three canisters, tap glass, pulses, contaminants, glow point lights, tap stream and filling glass; creates the orbit rig, wires raycast picking to selectStage, and starts the animate loop."}, {"id": "legacy_filtration_simulation_addcanister", "label": "addCanister()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L472", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Creates one stage canister (transmissive glass shell, emissive core, invisible sphere hit target) at a route point, registers the meshes as pickables with a stageKey, and records stagePositions and stageCores for that stage."}, {"id": "legacy_filtration_simulation_colorstops", "label": "colorStops", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L560", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Hard-coded colour stops along route parameter t (amber raw -> grey after sediment -> cyan after carbon -> mint at output) with abrupt 2-3% transitions at fixed fractions rather than across the element spans."}, {"id": "legacy_filtration_simulation_colorat", "label": "colorAt()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L570", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Piecewise-linear lookup of colorStops for a route parameter t, returning a lerped THREE.Color."}, {"id": "legacy_filtration_simulation_animate", "label": "animate()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L600", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "requestAnimationFrame loop: clamps delta to 50 ms, ticks the orbit rig, advances pulses along the curve at a constant speed and tints them via colorAt, moves two glow lights with pulses 0 and 4, advances jittered contaminants until their vanishAt fade, pulses the tap stream opacity and cycles the glass fill every 7 s, then renders."}, {"id": "legacy_filtration_simulation_water_pulses", "label": "Constant-speed Water Pulses", "file_type": "concept", "source_file": "legacy/filtration-simulation.html", "source_location": "L511", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "28 small spheres evenly spaced in phase along the single service-line curve, all advancing at the same speed (0.11 per second) regardless of stage, coloured by colorAt. Precursor of the time-spaced bubble column."}, {"id": "legacy_filtration_simulation_contaminant_specks", "label": "Vanishing Contaminant Specks", "file_type": "concept", "source_file": "legacy/filtration-simulation.html", "source_location": "L521", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "16 brown jittered spheres that ride in with the raw water and fade out at a random vanishAt fraction between 0.12 and 0.58 of the route, standing in for a filter stage catching them. Precursor of grit caught at the first element."}, {"id": "legacy_filtration_simulation_dark_glass_ui", "label": "Dark Navy Glass UI Theme", "file_type": "concept", "source_file": "legacy/filtration-simulation.html", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Inline CSS theme: navy-deep background with radial cyan/azure glows, translucent backdrop-blurred panels, fixed cyan accent, mint/amber for after/before values, floating pointer-events:none cards over the canvas, pill play bar and responsive hiding of trend/impact cards under 760px."}, {"id": "legacy_filtration_simulation_stageorder", "label": "stageOrder", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L651", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "['sediment','carbon','ro','tap'] - the four stage keys in walkthrough order."}, {"id": "legacy_filtration_simulation_stagedatabysystem", "label": "stageDataBySystem", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L652", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Per-system (whole / undersink / rain) title and description copy for each of the four stages."}, {"id": "legacy_filtration_simulation_rodotlabel", "label": "roDotLabel", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L672", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Label of the third stage dot per system: Minerals / RO / UV."}, {"id": "legacy_filtration_simulation_systemdata", "label": "systemData", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L673", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Per-system header title/subtitle and the cost-before/after/savings and bottles/waste figures shown in the floating cards."}, {"id": "legacy_filtration_simulation_selectstage", "label": "selectStage()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L684", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Sets currentStage, writes the detail card, stage count and progress width from stageDataBySystem/stageOrder, toggles the active stage dot, raises the selected canister core's emissiveIntensity (0.9 vs 0.28) and, unless skipZoom, flies the orbit rig to stagePositions[key]."}, {"id": "legacy_filtration_simulation_stopautoplay", "label": "stopAutoplay()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L722", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Clears the autoplay interval and restores the play icon."}, {"id": "legacy_filtration_simulation_startautoplay", "label": "startAutoplay()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L727", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Swaps the play icon to pause and advances to the next stage in stageOrder every 3200 ms via selectStage."}, {"id": "legacy_filtration_simulation_selectsystem", "label": "selectSystem()", "file_type": "code", "source_file": "legacy/filtration-simulation.html", "source_location": "L740", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Sets currentSystem, toggles the active sidebar button, writes header and card figures from systemData, relabels the RO dot, stops autoplay, resets the camera and re-applies the current stage without zooming. The 3D scene itself does not change per system in the prototype."}], "edges": [{"source": "legacy_filtration_simulation_buildscene", "target": "legacy_filtration_simulation_makeorbit", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "legacy/filtration-simulation.html", "source_location": "L581", "weight": 1.0}, {"source": "legacy_filtration_simulation_buildscene", "target": "legacy_filtration_simulation_addcanister", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "legacy/filtration-simulation.html", "source_location": "L496", "weight": 1.0}, {"source": "legacy_filtration_simulation_buildscene", "target": "legacy_filtration_simulation_animate", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "legacy/filtration-simulation.html", "source_location": "L638", "weight": 1.0}, {"source": "legacy_filtration_simulation_buildscene", "target": "legacy_filtration_simulation_selectstage", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "legacy/filtration-simulation.html", "source_location": "L593", "weight": 1.0}, {"source": "legacy_filtration_simulation_buildscene", "target": "legacy_filtration_simulation_colorstops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "legacy/filtration-simulation.html", "source_location": "L560", "weight": 1.0}, {"source": "legacy_filtration_simulation_animate", "target": "legac